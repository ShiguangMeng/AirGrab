<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AirGrab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:AirGrab.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 自绘标题栏 ================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Margin="18,0,0,0"
                VerticalAlignment="Center">
                <Border
                    Width="20" Height="20" CornerRadius="6"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock
                    Text="AirGrab"
                    FontSize="13" FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <Rectangle
                    Width="1" Height="15"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleBarSubtitle"
                    Text="投送"
                    FontSize="13" Opacity="0.7"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 导航 rail -->
            <StackPanel Grid.Column="0" Padding="0,6,0,0" Spacing="2">
                <Border x:Name="NavSend" Tag="send" Tapped="OnNavTapped"
                        Width="58" Height="46" CornerRadius="7" Margin="4,0">
                    <TextBlock Text="投送" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="NavDevices" Tag="devices" Tapped="OnNavTapped"
                        Width="58" Height="46" CornerRadius="7" Margin="4,0">
                    <TextBlock Text="设备" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="NavHistory" Tag="history" Tapped="OnNavTapped"
                        Width="58" Height="46" CornerRadius="7" Margin="4,0">
                    <TextBlock Text="记录" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="NavSettings" Tag="settings" Tapped="OnNavTapped"
                        Width="58" Height="46" CornerRadius="7" Margin="4,0">
                    <TextBlock Text="设置" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- 页面容器：四个页面各自独立，切换可见性 -->
            <Grid Grid.Column="1">

                <!-- ========== 投送 ========== -->
                <ScrollViewer x:Name="PageSend" Padding="26,14,26,24" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="投送" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock x:Name="SendSubtitle" FontSize="12.5" Opacity="0.66" />
                        </StackPanel>

                        <Border
                            CornerRadius="9" Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border
                                        Width="42" Height="42" CornerRadius="12"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock
                                            x:Name="HandGlyph"
                                            Text="✋" FontSize="19"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="White" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{x:Bind Model.StateTitle, Mode=OneWay}"
                                                FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{x:Bind Model.StateCode, Mode=OneWay}"
                                                FontSize="10.5" FontFamily="Consolas" Opacity="0.5"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{x:Bind Model.StateHint, Mode=OneWay}"
                                            FontSize="11.5" Opacity="0.66" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind Model.CarriedName, Mode=OneWay}"
                                        FontSize="11" FontFamily="Consolas" Opacity="0.55"
                                        VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>

                                <ProgressBar
                                    Maximum="4"
                                    Value="{x:Bind Model.StateStep, Mode=OneWay}"
                                    Height="4" CornerRadius="2" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CaptureButton" Content="从剪贴板抓取" Click="OnCaptureClicked" />
                            <Button Content="投送首项" Click="OnSendFirstClicked" />
                            <Button Content="清空记录" Click="OnClearHistoryClicked" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="可抓取内容" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{x:Bind Model.Outbox.Count, Mode=OneWay}"
                                FontSize="11.5" FontFamily="Consolas" Opacity="0.5"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind Model.Outbox}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:Payload">
                                    <Border
                                        Width="238" Height="132" Margin="0,0,13,13"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        PointerPressed="OnPayloadPointerPressed"
                                        PointerMoved="OnPayloadPointerMoved"
                                        PointerReleased="OnPayloadPointerReleased">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="82" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" CornerRadius="8,8,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#5B8DEF" Offset="0" />
                                                        <GradientStop Color="#7A4BFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock
                                                    Text="{x:Bind ExtensionTag}"
                                                    FontSize="19" FontWeight="SemiBold"
                                                    Foreground="White" Opacity="0.92"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Row="1" Padding="11,8" Spacing="3">
                                                <TextBlock
                                                    Text="{x:Bind Name}"
                                                    FontSize="12.3" FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind SizeText}"
                                                    FontSize="10.5" FontFamily="Consolas" Opacity="0.55" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Text="按住卡片拖动 = 握拳抓取；松手 = 张开手掌投送。附近没有设备时投送至本机回环，内容会真实落地。"
                            FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 设备 ========== -->
                <ScrollViewer x:Name="PageDevices" Padding="26,14,26,24"
                              Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="设备" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock x:Name="DevicesSubtitle" FontSize="12.5" Opacity="0.66" />
                        </StackPanel>

                        <Border
                            CornerRadius="9" Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="38" Height="38" CornerRadius="10"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="本" FontSize="14" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="本机（回环）" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="始终可用 · 投送内容直接落到本机" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="局域网设备" FontSize="13" FontWeight="SemiBold" />

                        <ItemsControl ItemsSource="{x:Bind Model.Peers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:Peer">
                                    <Border
                                        Width="300" Margin="0,0,13,13"
                                        CornerRadius="7" Padding="13,11"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="11">
                                            <Border Width="34" Height="34" CornerRadius="9"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <TextBlock Text="{x:Bind Platform}"
                                                           FontSize="11" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12.8" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Address}" FontSize="11" Opacity="0.6" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Text="尚未发现局域网设备时，投送会自动回落到本机回环。发现依靠 UDP 广播，跨网段或防火墙拦截会导致收不到信标。"
                            FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" />

                        <Border
                            CornerRadius="9" Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="发现机制" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="UDP 广播信标每 2 秒一次，端口 25585；超过 8 秒未续期即判定离线。不依赖账号体系。"
                                    FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 记录 ========== -->
                <ScrollViewer x:Name="PageHistory" Padding="26,14,26,24"
                              Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="记录" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock x:Name="HistorySubtitle" FontSize="12.5" Opacity="0.66" />
                        </StackPanel>

                        <TextBlock Text="已接收" FontSize="13" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{x:Bind Model.Inbox}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:Payload">
                                    <Border
                                        Margin="0,0,0,9" Padding="12,10"
                                        CornerRadius="7"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="11">
                                            <Border Width="32" Height="32" CornerRadius="8">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#14D6A4" Offset="0" />
                                                        <GradientStop Color="#3B8DFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{x:Bind ExtensionTag}" FontSize="9" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind SizeText}" FontSize="10.5"
                                                           FontFamily="Consolas" Opacity="0.55" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="已投送" FontSize="13" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{x:Bind Model.Outbox}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:Payload">
                                    <Border
                                        Margin="0,0,0,9" Padding="12,10"
                                        CornerRadius="7"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="11">
                                            <Border Width="32" Height="32" CornerRadius="8">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#5B8DEF" Offset="0" />
                                                        <GradientStop Color="#7A4BFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{x:Bind ExtensionTag}" FontSize="9" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind SizeText}" FontSize="10.5"
                                                           FontFamily="Consolas" Opacity="0.55" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 设置 ========== -->
                <ScrollViewer x:Name="PageSettings" Padding="26,14,26,24"
                              Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock x:Name="SettingsSubtitle" FontSize="12.5" Opacity="0.66" />
                        </StackPanel>

                        <TextBlock Text="手势通道" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ChannelSimButton" Content="模拟输入" Click="OnChannelSimClicked" />
                            <Button x:Name="ChannelCamButton" Content="摄像头识别" Click="OnChannelCamClicked" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ChannelDetail"
                            FontSize="11.5" Opacity="0.66" TextWrapping="Wrap" />

                        <Border
                            CornerRadius="9" Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="通道说明" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="模拟输入由指针事件驱动同一套手势状态机，用于无摄像头环境；摄像头通道接入手部关键点推理后，两条通道产生的输入结构完全一致，状态机不作区分。"
                                    FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="服务状态" FontSize="13" FontWeight="SemiBold" />
                        <Border
                            CornerRadius="9" Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="7">
                                <TextBlock x:Name="ServiceLine" FontSize="11.5" FontFamily="Consolas"
                                           Opacity="0.75" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="AGG|&lt;type&gt;|&lt;size&gt;|&lt;name&gt;|&lt;payload&gt;   ·   UDP :25585 发现 · TCP :25586 传输 · 分片 64 KB + 逐片 CRC32"
                                    FontSize="10.5" FontFamily="Consolas" Opacity="0.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= 拖拽浮层 ================= -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="2" IsHitTestVisible="False">
            <Border
                x:Name="DragGhost"
                Visibility="Collapsed"
                CornerRadius="14" Padding="11,9"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="30" Height="30" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5B8DEF" Offset="0" />
                                <GradientStop Color="#7A4BFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="DragGhostName" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="DragGhostHint" FontSize="10.5" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
