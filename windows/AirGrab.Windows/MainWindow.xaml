<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AirGrab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:AirGrab.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 自绘标题栏 ================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Margin="18,0,0,0"
                VerticalAlignment="Center">
                <Border
                    Width="20" Height="20" CornerRadius="6"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock
                    Text="AirGrab"
                    FontSize="13" FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <Rectangle
                    Width="1" Height="15"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleBarSubtitle"
                    Text="设备"
                    FontSize="13" Opacity="0.7"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 导航 rail -->
            <StackPanel Grid.Column="0" Padding="0,6,0,0" Spacing="2">
                <Border x:Name="NavSend" Tag="send" Tapped="OnNavTapped"
                        Width="58" Height="46" CornerRadius="7" Margin="4,0">
                    <TextBlock Text="投送" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="NavDevices" Tag="devices" Tapped="OnNavTapped"
                        Width="58" Height="46" CornerRadius="7" Margin="4,0">
                    <TextBlock Text="设备" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="NavHistory" Tag="history" Tapped="OnNavTapped"
                        Width="58" Height="46" CornerRadius="7" Margin="4,0">
                    <TextBlock Text="记录" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="NavSettings" Tag="settings" Tapped="OnNavTapped"
                        Width="58" Height="46" CornerRadius="7" Margin="4,0">
                    <TextBlock Text="设置" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- 内容区 -->
            <ScrollViewer Grid.Column="1" Padding="26,14,26,22" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">

                    <!-- 页头 -->
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="PageTitle"
                            Text="附近设备"
                            FontSize="26" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="PageSubtitle"
                            Text="正在发现局域网内的设备…"
                            FontSize="12.5" Opacity="0.66" />
                    </StackPanel>

                    <!-- 隔空手势状态 -->
                    <Border
                        CornerRadius="9" Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border
                                    x:Name="HandChip"
                                    Width="42" Height="42" CornerRadius="12"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock
                                        x:Name="HandGlyph"
                                        Text="✋" FontSize="19"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Foreground="White" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Text="{x:Bind Model.StateTitle, Mode=OneWay}"
                                            FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="{x:Bind Model.StateCode, Mode=OneWay}"
                                            FontSize="10.5" FontFamily="Consolas" Opacity="0.5"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind Model.StateHint, Mode=OneWay}"
                                        FontSize="11.5" Opacity="0.66" />
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind Model.CarriedName, Mode=OneWay}"
                                    FontSize="11" FontFamily="Consolas" Opacity="0.55"
                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>

                            <ProgressBar
                                Maximum="4"
                                Value="{x:Bind Model.StateStep, Mode=OneWay}"
                                Height="4" CornerRadius="2" />
                        </StackPanel>
                    </Border>

                    <!-- 附近设备 -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="附近设备" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{x:Bind Model.PeerCount, Mode=OneWay}"
                                FontSize="11.5" FontFamily="Consolas" Opacity="0.5"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind Model.Peers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:Peer">
                                    <Border
                                        Width="300" Margin="0,0,13,13"
                                        CornerRadius="7" Padding="13,11"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="11">
                                            <Border
                                                Width="34" Height="34" CornerRadius="9"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <TextBlock
                                                    Text="{x:Bind Glyph}"
                                                    FontFamily="Segoe Fluent Icons" FontSize="15"
                                                    Foreground="White"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12.8" FontWeight="SemiBold" />
                                                <TextBlock
                                                    Text="{x:Bind Platform}"
                                                    FontSize="11" Opacity="0.6" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 最近投送 -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="最近投送" FontSize="13" FontWeight="SemiBold" />

                        <ItemsControl ItemsSource="{x:Bind Model.Outbox}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:Payload">
                                    <Border
                                        Width="238" Height="132" Margin="0,0,13,13"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        PointerPressed="OnPayloadPointerPressed"
                                        PointerMoved="OnPayloadPointerMoved"
                                        PointerReleased="OnPayloadPointerReleased">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="82" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" CornerRadius="8,8,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#5B8DEF" Offset="0" />
                                                        <GradientStop Color="#7A4BFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock
                                                    Text="{x:Bind ExtensionTag}"
                                                    FontSize="19" FontWeight="SemiBold"
                                                    Foreground="White" Opacity="0.92"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Row="1" Padding="11,8" Spacing="3">
                                                <TextBlock
                                                    Text="{x:Bind Name}"
                                                    FontSize="12.3" FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind SizeText}"
                                                    FontSize="10.5" FontFamily="Consolas" Opacity="0.55" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 传输日志 -->
                    <Border
                        CornerRadius="9" Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="7">
                            <TextBlock Text="传输通道" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{x:Bind Model.TransferLog, Mode=OneWay}"
                                FontSize="11.5" FontFamily="Consolas" Opacity="0.7"
                                TextWrapping="Wrap" />
                            <ProgressBar
                                Maximum="1"
                                Value="{x:Bind Model.TransferProgress, Mode=OneWay}"
                                Height="3" />
                            <TextBlock
                                Text="AGG|&lt;type&gt;|&lt;size&gt;|&lt;name&gt;|&lt;payload&gt;   ·   TCP 分片 64 KB + 逐片 CRC32"
                                FontSize="10.5" FontFamily="Consolas" Opacity="0.45"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= 拖拽浮层 ================= -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="2" IsHitTestVisible="False">
            <Border
                x:Name="DragGhost"
                Visibility="Collapsed"
                CornerRadius="14" Padding="11,9"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="30" Height="30" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5B8DEF" Offset="0" />
                                <GradientStop Color="#7A4BFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="DragGhostName" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="DragGhostHint" FontSize="10.5" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
