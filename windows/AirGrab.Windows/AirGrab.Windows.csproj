<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AirGrab</RootNamespace>
    <AssemblyName>AirGrab</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- SoftwareBitmap 的像素读取需要经 IMemoryBufferByteAccess 指针访问。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.25.1" />
  </ItemGroup>

  <!--
    手势模型随产物分发，不做运行时下载。
    palm_detection 在整帧上定位手掌，handpose 在裁剪出的手掌区域上出 21 关键点。
    两者均为 MediaPipe 官方模型的 ONNX 转换版（Apache 2.0），
    关键点定义与 iOS 端 Vision 使用的同一套 21 点语义完全一致。

    作为**嵌入资源**而非内容文件：单文件发布（PublishSingleFile）不会把
    子目录内容打进 exe，只有嵌入资源才会随程序集合并 —— 这样 exe 才真正自包含。
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\palm_detection_mediapipe_2023feb.onnx" />
    <EmbeddedResource Include="Assets\handpose_estimation_mediapipe_2023feb.onnx" />
  </ItemGroup>

</Project>
